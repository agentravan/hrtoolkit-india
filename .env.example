NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Supabase/Postgres — SERVER ONLY
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key

# Private generated files / payment proof
BLOB_READ_WRITE_TOKEN=server-only-vercel-blob-token

# Background jobs
QSTASH_TOKEN=server-only-qstash-token
QSTASH_CURRENT_SIGNING_KEY=server-only
QSTASH_NEXT_SIGNING_KEY=server-only

# AI
OPENROUTER_API_KEY=server-only-openrouter-key
OPENROUTER_MODEL=openai/gpt-5.1
AI_MAX_COST_USD_PER_ORDER=0.50
AI_MAX_DAILY_COST_USD=10.00

# Manual UPI payment adapter
UPI_ID=your-upi-id@bank
UPI_PAYEE_NAME=HRToolKit India

# Admin
ADMIN_PASSWORD=strong-admin-password
ACTION_SIGNING_SECRET=long-random-secret-at-least-32-chars

# SMTP / Zoho
ZOHO_SMTP_HOST=smtp.zoho.in
ZOHO_SMTP_PORT=465
ZOHO_SMTP_SECURE=true
ZOHO_SMTP_USER=teamwork.hrsolution@zohomail.in
ZOHO_SMTP_PASS=your-zoho-app-password
MAIL_FROM=teamwork.hrsolution@zohomail.in
ADMIN_EMAIL=teamwork.hrsolution@zohomail.in

# Application controls
TERMS_VERSION=2026-09-24
ORDER_RATE_LIMIT_PER_HOUR=5
PAYMENT_RATE_LIMIT_PER_HOUR=5
GENERATION_TIMEOUT_MINUTES=60
RETENTION_DAYS=30
